<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculatorTelefono.MainPage"
             BackgroundColor="Black">

    <Grid RowDefinitions="*, Auto" Padding="24">
        <VerticalStackLayout Grid.Row="0" VerticalOptions="End" Spacing="5">
            <Label x:Name="lblDisplay" 
                   Text="0" 
                   TextColor="White" 
                   FontSize="64" 
                   HorizontalTextAlignment="End" 
                   LineBreakMode="TailTruncation"/>
        </VerticalStackLayout>

        <Grid Grid.Row="1" 
              RowDefinitions="Auto,Auto,Auto,Auto,Auto" 
              ColumnDefinitions="*,*,*,*" 
              RowSpacing="12" 
              ColumnSpacing="12">

            <Button Grid.Row="0" Grid.Column="0" Text="AC" Style="{StaticResource OperatorAccentStyle}" Clicked="OnClearClicked"/>
            <Button Grid.Row="0" Grid.Column="1" Text="⌫" Style="{StaticResource OperatorAccentStyle}" Clicked="OnBackspaceClicked"/>
            <Button Grid.Row="0" Grid.Column="2" Text="%" Style="{StaticResource OperatorAccentStyle}" Clicked="OnOperatorClicked"/>
            <Button Grid.Row="0" Grid.Column="3" Text="÷" Style="{StaticResource OperatorAccentStyle}" Clicked="OnOperatorClicked"/>

            <Button Grid.Row="1" Grid.Column="0" Text="7" Style="{StaticResource NumberButtonStyle}" Clicked="OnNumberClicked"/>
            <Button Grid.Row="1" Grid.Column="1" Text="8" Style="{StaticResource NumberButtonStyle}" Clicked="OnNumberClicked"/>
            <Button Grid.Row="1" Grid.Column="2" Text="9" Style="{StaticResource NumberButtonStyle}" Clicked="OnNumberClicked"/>
            <Button Grid.Row="1" Grid.Column="3" Text="×" Style="{StaticResource OperatorAccentStyle}" Clicked="OnOperatorClicked"/>

            <Button Grid.Row="2" Grid.Column="0" Text="4" Style="{StaticResource NumberButtonStyle}" Clicked="OnNumberClicked"/>
            <Button Grid.Row="2" Grid.Column="1" Text="5" Style="{StaticResource NumberButtonStyle}" Clicked="OnNumberClicked"/>
            <Button Grid.Row="2" Grid.Column="2" Text="6" Style="{StaticResource NumberButtonStyle}" Clicked="OnNumberClicked"/>
            <Button Grid.Row="2" Grid.Column="3" Text="-" Style="{StaticResource OperatorAccentStyle}" Clicked="OnOperatorClicked"/>

            <Button Grid.Row="3" Grid.Column="0" Text="1" Style="{StaticResource NumberButtonStyle}" Clicked="OnNumberClicked"/>
            <Button Grid.Row="3" Grid.Column="1" Text="2" Style="{StaticResource NumberButtonStyle}" Clicked="OnNumberClicked"/>
            <Button Grid.Row="3" Grid.Column="2" Text="3" Style="{StaticResource NumberButtonStyle}" Clicked="OnNumberClicked"/>
            <Button Grid.Row="3" Grid.Column="3" Text="+" Style="{StaticResource OperatorAccentStyle}" Clicked="OnOperatorClicked"/>

            <Button Grid.Row="4" Grid.Column="0" Text="↺" Style="{StaticResource OperatorAccentStyle}" Clicked="OnExtraClicked"/>
            <Button Grid.Row="4" Grid.Column="1" Text="0" Style="{StaticResource NumberButtonStyle}" Clicked="OnNumberClicked"/>
            <Button Grid.Row="4" Grid.Column="2" Text="." Style="{StaticResource NumberButtonStyle}" Clicked="OnDecimalClicked"/>
            <Button Grid.Row="4" Grid.Column="3" Text="=" Style="{StaticResource EqualsButtonStyle}" Clicked="OnEqualsClicked"/>
        </Grid>
    </Grid>

    <ContentPage.Resources>
        <Style x:Key="NumberButtonStyle" TargetType="Button">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="BackgroundColor" Value="Black"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="CornerRadius" Value="38"/>
            <Setter Property="HeightRequest" Value="76"/>
        </Style>

        <Style x:Key="OperatorAccentStyle" TargetType="Button">
            <Setter Property="TextColor" Value="#FF9F0A"/>
            <Setter Property="BackgroundColor" Value="Black"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="CornerRadius" Value="38"/>
            <Setter Property="HeightRequest" Value="76"/>
        </Style>

        <Style x:Key="EqualsButtonStyle" TargetType="Button">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="BackgroundColor" Value="#FF9F0A"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="CornerRadius" Value="38"/>
            <Setter Property="HeightRequest" Value="76"/>
        </Style>
    </ContentPage.Resources>
</ContentPage>